terraform {
  required_version = ">= 1.9"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }

  # State stays local on purpose — this stack is written to be applied,
  # but is intentionally not deployed to avoid personal AWS costs.
  # For a real deployment: S3 backend + DynamoDB lock table.
}

provider "aws" {
  region = var.region

  default_tags {
    tags = {
      Project   = var.project
      ManagedBy = "terraform"
    }
  }
}
